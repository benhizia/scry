# --- Environnement Python ---------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# --- Configuration locale ---------------------------------------------------
# Renseigne une fois par poste, avec des chemins absolus (castxml, toolset)
# qui n'ont de sens que sur cette machine. Le modele versionne est
# scry.ini.example ; le copier en scry.ini au premier clone.
scry.ini

# --- Sorties de Scry --------------------------------------------------------
# Le header d'introspection est regenere par 'scry gen' a partir du header
# source : c'est un artefact, pas une source. Le versionner ferait diverger le
# depot du layout reel des le premier changement de toolset.
Generated/
generated/

# Sources de Dear ImGui, deposees a la main ou par 'scry viewer --fetch-imgui'.
# Seul le README, qui explique ou les mettre, est versionne. L'exe et ses
# objets vont dans build/, deja ignore plus haut.
third_party/*
!third_party/README.md

# Cache pygccxml. Binaire, volumineux, et lie aux chemins absolus du poste.
.scry_cache/
.bpg_cache/

# --- Outils ----------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Layout des fenetres ImGui, ecrit au format brut a chaque fermeture de l'UI.
imgui.ini

# Genere par l'extension C/C++ Runner, avec des chemins absolus propres au
# poste. Rien ici ne concerne le projet Python.
.vscode/

# --- Systeme ---------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
